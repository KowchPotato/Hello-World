# ============================================================
# RuthlessCompounder Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- Mode ---
# Set to "testnet" for devnet/testnets, "mainnet" for live
MODE=testnet

# --- Solana ---
# Encrypted private key (base64-encoded ciphertext). See README for key encryption.
SOLANA_ENCRYPTED_KEY=
SOLANA_KEY_PASSWORD=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_WS=wss://api.devnet.solana.com

# --- EVM ---
# Encrypted private key (base64-encoded ciphertext)
EVM_ENCRYPTED_KEY=
EVM_KEY_PASSWORD=

# Base L2
BASE_RPC_URL=https://mainnet.base.org
# Arbitrum L2
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:72b-instruct-q4_K_M

# --- Dashboard ---
DASHBOARD_PORT=8501

# --- Emergency ---
# Telegram bot token + chat ID for alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=INFO
